rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'HN7f9PmeCgg3nd8WRFb6EhJVPnl2';
    }

    match /burgers/{burgerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /meta/collectionSummary {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/searchIndex {
      allow read: if true;
      allow write: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /meta/sitemap {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

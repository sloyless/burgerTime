rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'HN7f9PmeCgg3nd8WRFb6EhJVPnl2';
    }

    match /burgers/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
